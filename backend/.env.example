# ─────────────────────────────────────────────────────────────────────────────
# TraceShield – Backend Environment Configuration
# Copy this file to .env and fill in your API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Model ──────────────────────────────────────────────────────────────────
# Hugging Face Inference API key (get free at https://huggingface.co/settings/tokens)
# Leave blank to use rule-based fallback mode (demo).
HF_API_TOKEN=

# Optional: override which HF model is used (default: Qwen/Qwen2.5-1.5B-Instruct)
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# ── QLoRA Adapter (future) ────────────────────────────────────────────────────
# Path to your trained QLoRA adapter directory (set when adapter is ready)
# QLORA_ADAPTER_PATH=./adapters/scam_detector_v1

# ── Search API ────────────────────────────────────────────────────────────────
# Tavily Search API key (free tier at https://app.tavily.com/)
TAVILY_API_KEY=

# ── Intelligence API ──────────────────────────────────────────────────────────
# NewsAPI.org key (free tier at https://newsapi.org/register)
NEWS_API_KEY=

# ── Server Config ─────────────────────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
